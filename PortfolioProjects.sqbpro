="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="66"/><column index="2" value="70"/><column index="3" value="70"/><column index="4" value="70"/><column index="5" value="75"/><column index="6" value="79"/><column index="7" value="177"/><column index="8" value="172"/><column index="9" value="147"/><column index="10" value="245"/><column index="11" value="93"/><column index="12" value="108"/><column index="13" value="88"/><column index="14" value="128"/><column index="15" value="131"/><column index="16" value="166"/><column index="17" value="124"/><column index="18" value="196"/><column index="19" value="219"/><column index="20" value="222"/><column index="21" value="258"/><column index="22" value="276"/><column index="23" value="120"/><column index="24" value="133"/><column index="25" value="87"/><column index="26" value="106"/><column index="27" value="105"/><column index="28" value="110"/><column index="29" value="119"/><column index="30" value="157"/><column index="31" value="144"/><column index="32" value="115"/><column index="33" value="102"/><column index="34" value="158"/><column index="35" value="198"/><column index="36" value="111"/><column index="37" value="187"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">/*
Covid 19 Data Exploration 

Skills used: Joins, CTE's, Temp Tables, Windows Functions, Aggregate Functions, Creating Views, Converting Data Types

*/
-- Convert datatype on date column IN BOTH DATASET

-- CovidDeaths
ALTER TABLE CovidDeaths ADD COLUMN date_parsed TEXT;

-- Populate it (adjust substr logic to match your format)
UPDATE CovidDeaths
SET date_parsed = substr(date, 7, 4) || '-' || substr(date, 4, 2) || '-' || substr(date, 1, 2);

-- Now ORDER BY date_parsed works correctly
SELECT * FROM CovidDeaths ORDER BY date_parsed;


--CovidVaccinations
ALTER TABLE CovidVaccinations ADD COLUMN date_parsed TEXT;
UPDATE CovidVaccinations
SET date_parsed = substr(date, 7, 4) || '-' || substr(date, 4, 2) || '-' || substr(date, 1, 2);

-- Then ORDER BY safely
SELECT * FROM CovidVaccinations ORDER BY date_parsed;


-- Begin Data Exploration

SELECT *
FROM CovidDeaths 
WHERE continent IS NOT NULL
ORDER BY 3,4

-- Select the data that we are going to use --

SELECT location, date, total_cases, new_cases, total_deaths, population
FROM CovidDeaths
ORDER BY 1, 2



-- Total Cases  Vs Total Deaths
-- Shows likelihood of dying if contracted covid in Singapore

SELECT location, date, total_cases, total_deaths,
(total_deaths  / total_cases)* 100 AS death_percentage
FROM CovidDeaths
WHERE location LIKE '%Singapore%'



-- Total cases Vs Population
-- Shows what percentage of population got Covid in Singapore

SELECT location, population, total_cases, 
(total_cases  / population)* 100 AS case_percentage
FROM CovidDeaths
WHERE location LIKE '%Singapore%'



-- Countries with Highest Infection Rate compared to Population

SELECT location,  population, 
MAX(total_cases) AS HighestInfectionCountry,
MAX(total_cases / population)* 100 AS  PercentPopulaitonInfected
FROM CovidDeaths
GROUP BY location, population
ORDER BY PercentPopulaitonInfected DESC



--  Countries with Highest Death Count per Population
SELECT location,  MAX(total_deaths) AS TotalDeathCount
FROM CovidDeaths
WHERE continent IS NOT NULL
GROUP BY location
ORDER BY TotalDeathCount DESC






-- Break things down by continent


-- Selecting the data 

SELECT location,  MAX(total_deaths) AS TotalDeathCount
FROM CovidDeaths
WHERE continent IS NULL
GROUP BY location
ORDER BY TotalDeathCount DESC



-- Continents with the Highest Death Count per Population

SELECT continent,  MAX(total_deaths) AS TotalDeathCount
FROM CovidDeaths
WHERE continent IS NOT NULL
GROUP BY continent
ORDER BY TotalDeathCount DESC




-- Global Numbers

SELECT 
    SUM(new_cases) AS total_cases, 
    SUM(new_deaths) AS total_deaths, 
    (SUM(new_deaths) * 100.0 / SUM(new_cases)) AS DeathPercentage 
	--since my datatype is INT, need to multiply with float first to get decimal number
FROM CovidDeaths
WHERE continent IS NOT NULL
--GROUP BY date
ORDER BY 1, 2




-- Combining CovidDeaths and CovidVaccinations
SELECT dea.continent, dea.location, dea.date, dea.population, vac.new_vaccinations
FROM CovidDeaths dea
JOIN CovidVaccinations vac
	ON dea.location = vac.location
	AND dea.date = vac.date
WHERE dea.continent IS NOT NULL
ORDER BY 1,2,3




-- Total Population Vs Vaccinations
-- Shows Percentage of Population that has recieved at least one Covid Vaccine

SELECT dea.continent, dea.location, dea.date_parsed, dea.population, vac.new_vaccinations,
    SUM(vac.new_vaccinations) OVER (PARTITION BY dea.location ORDER BY dea.date_parsed) AS RollingPeopleVaccinated
FROM CovidDeaths dea
JOIN CovidVaccinations vac
    ON dea.location = vac.location
    AND dea.date_parsed = vac.date_parsed
WHERE dea.continent IS NOT NULL
ORDER BY 2, 3;



-- Using CTE to perform Calculation on Partition By in previous query 
-- If the number of columns in the CTE and the query is different, it will give error, so double check

With PopvsVac (Continent, Location, Date_parsed, Population, New_Vaccinations, RollingPeopleVaccinated) -- cte
as
(
SELECT dea.continent, dea.location, dea.date_parsed, dea.population, vac.new_vaccinations,
    SUM(vac.new_vaccinations) OVER (PARTITION BY dea.location ORDER BY dea.date_parsed) AS RollingPeopleVaccinated -- query
FROM CovidDeaths dea
JOIN CovidVaccinations vac
    ON dea.location = vac.location
    AND dea.date_parsed = vac.date_parsed
WHERE dea.continent IS NOT NULL
--ORDER BY 2, 3;
)
Select *, (RollingPeopleVaccinated/Population)*100 AS RollingPeopleVaccinated_Percentage
From PopvsVac







-- Using Temp Table to perform Calculation on Partition By in previous query, (However, doesn't exist in SQL lite)
-- 
-- DROP Table if exists #PercentPopulationVaccinated
-- CREATE TABLE #PercentPopulationVaccinated
-- (
-- Continent nvarchar(255),
-- Location nvarchar(255),
-- date_parsed TEXT,
-- Population REAL,
-- New_vaccinations REAL,
-- RollingPeopleVaccinated REAL
-- )
-- 
-- Insert into #PercentPopulationVaccinated
-- SELECT dea.continent, dea.location, dea.date_parsed, dea.population, vac.new_vaccinations,
--     SUM(vac.new_vaccinations) OVER (PARTITION BY dea.location ORDER BY dea.date_parsed) AS RollingPeopleVaccinated -- query
-- FROM CovidDeaths dea
-- JOIN CovidVaccinations vac
--     ON dea.location = vac.location
--     AND dea.date_parsed = vac.date_parsed
-- WHERE dea.continent IS NOT NULL
-- ORDER BY 2, 3;
-- 
-- Select *, (RollingPeopleVaccinated/Population)*100 AS RollingPeopleVaccinated_Percentage
-- From #PercentPopulationVaccinated
-- -- 




-- Creating View to store data for later visualizations

DROP VIEW IF EXISTS PercentPopulationVaccinated;

CREATE VIEW PercentPopulationVaccinated AS
SELECT dea.continent, dea.location, dea.date_parsed, dea.population, vac.new_vaccinations,
    SUM(vac.new_vaccinations) OVER (PARTITION BY dea.location ORDER BY dea.date_parsed) AS RollingPeopleVaccinated
FROM CovidDeaths dea
JOIN CovidVaccinations vac
    ON dea.location = vac.location
    AND dea.date_parsed = vac.date_parsed
WHERE dea.continent IS NOT NULL;



SELECT *, (RollingPeopleVaccinated/Population)*100 AS RollingPeopleVaccinated_Percentage
FROM PercentPopulationVaccinated
ORDER BY 2, 3;</sql><sql name="SQL 3">SELECT DISTINCT date FROM CovidDeaths LIMIT 5;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
